#!/bin/sh

test -z "$NDK" && export NDK=$HOME/Android/Sdk/android-ndk-r26d
# ABI для сборки: по умолчанию оба — armeabi-v7a (бинарь для стенда) и
# arm64-v8a (legacy-артефакт для APK и install/mk-update). Переопределяется
# переменной AFRD_ABIS, напр. AFRD_ABIS=armeabi-v7a ./mka
test -z "$AFRD_ABIS" && AFRD_ABIS="armeabi-v7a arm64-v8a"
$NDK/ndk-build APP_ABI="$AFRD_ABIS" $* || exit $?

test -n "$*" && exit 0

ANDRAW=android/app/src/main/res/raw
for afrd in libs/*/afrd ; do
	arch=$(basename $(dirname $afrd) | tr '-' '_')
	cp $afrd $ANDRAW/afrd_$arch
done

VERSION=`sed main.c -ne '/const char \*g_version/{' -e 's/^.*= *"//' -e 's/".*$//' -e p -e '}'`
SUFFIX=`sed main.c -ne '/const char \*g_ver_sfx/{' -e 's/^.*= *"//' -e 's/".*$//' -e p -e '}'`
# Числовая версия для Android и Magisk: major*10000 + minor*100 + patch
# (та же формула, что в README/журнале). Без ведущих нулей: 0.3.3 -> 303.
vpart() { echo "$VERSION" | cut -d. -f"$1" | sed 's/^0*//' ; }
VMAJ=`vpart 1`; VMIN=`vpart 2`; VPAT=`vpart 3`
VMAJ=${VMAJ:-0}; VMIN=${VMIN:-0}; VPAT=${VPAT:-0}
VCODE=`expr "$VMAJ" \* 10000 + "$VMIN" \* 100 + "$VPAT"`
BUILD=android/app/build.gradle
sed -e "s/\( *versionName *'\).*\('\)/\1$VERSION\2/" \
    -e "s/\( *versionNameSuffix *'\).*\('\)/\1$SUFFIX\2/" \
    -e "s/\( *versionCode *\).*/\1$VCODE/" \
	"${BUILD}" > "${BUILD}~"
if ! cmp -s "${BUILD}~" "${BUILD}" ; then
	mv -f "${BUILD}~" "${BUILD}"
	echo "Updated Android version number to $VERSION$SUFFIX ($VCODE)"
else
	rm -f "${BUILD}~"
fi

# Версия Magisk-модуля — из того же источника, иначе обновление модуля
# приносит прежний номер и Magisk не видит смену версии.
PROP=install/magisk/module.prop
sed -e "s|^version=.*|version=$VERSION$SUFFIX|" \
    -e "s|^versionCode=.*|versionCode=$VCODE|" \
	"${PROP}" > "${PROP}~"
if ! cmp -s "${PROP}~" "${PROP}" ; then
	mv -f "${PROP}~" "${PROP}"
	echo "Updated Magisk module version to $VERSION$SUFFIX ($VCODE)"
else
	rm -f "${PROP}~"
fi

# Строка о версии форка в README — тоже из main.c (согласованность проверяет
# tests/test_versions.sh).
README=README.md
sed "s|^AFRd2 — версия .*|AFRd2 — версия $VERSION$SUFFIX (номер синхронизируется из main.c сборкой ./mka).|" \
	"${README}" > "${README}~"
if ! cmp -s "${README}~" "${README}" ; then
	mv -f "${README}~" "${README}"
	echo "Updated README version to $VERSION$SUFFIX"
else
	rm -f "${README}~"
fi

cp config/afrd-android7-.ini android/app/src/main/res/raw/afrd_7.ini
cp config/afrd-android8+.ini android/app/src/main/res/raw/afrd_8.ini
cp config/afrd-minix7-.ini android/app/src/main/res/raw/afrd_minix7.ini
cp config/afrd2.ini android/app/src/main/res/raw/afrd_atv14.ini
cp ChangeLog-en.txt android/app/src/main/res/raw/changelog.txt
cp ChangeLog-ru.txt android/app/src/main/res/raw-ru/changelog.txt
cp FAQ-en.txt android/app/src/main/res/raw/faq.txt
cp FAQ-ru.txt android/app/src/main/res/raw-ru/faq.txt
cp COPYING.txt android/app/src/main/res/raw/copying.txt
cp COPYING-ru.txt android/app/src/main/res/raw-ru/copying.txt
