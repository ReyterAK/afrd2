#!/bin/sh
#
# This script will build a release APK from scratch.
#

test -z "$NDK" && export NDK=$HOME/Android/Sdk/android-ndk-r26d

# AGP 8 и Gradle 8.2 собираются только на JDK 17 (на JDK 11 — отказ).
export JAVA_HOME=${AFRD_JAVA_HOME:-/usr/lib/jvm/java-17-openjdk-amd64}

# abort on first error
set -e

./mka clean
./mka

# POSIX sh: pushd/popd есть только в bash, скрипт запускают как ./release
( cd android && ./gradlew clean && ./gradlew assembleRelease )

OUT=android/app/build/outputs/apk/release
APK=$(find $OUT -name '*.apk')
if test -z "$APK" ; then
	echo "No built APK file in $OUT"
	exit
fi

VERSION=`sed main.c -ne '/const char \*g_version/{' -e 's/^.*= *"//' -e 's/".*$//' -e p -e '}'`
SUFFIX=`sed main.c -ne '/const char \*g_ver_sfx/{' -e 's/^.*= *"//' -e 's/".*$//' -e p -e '}'`

mkdir -p releases
RELEASE=releases/ru.reyter.afrd2-${VERSION}${SUFFIX}-release.apk
mv "$APK" "$RELEASE"

echo "Finished $RELEASE"
