<?xml version="1.0" encoding="utf-8"?>
<!-- Раскладка: шесть групп по назначению (журнал §33.13). Раньше верхний уровень
     был 11 строк, и важное (новый путь, Android 12+) уезжало вниз; теперь в корне
     шесть групп, а нужное пользователю (включение, пауза, плееры, выбор режима)
     лежит в первых трёх. Применимость по-прежнему помечается построчно
     (SettingsFragment.markInapplicable), поэтому внутри групп перемешаны ключи
     обоих путей — это осознанно.
     Исключение из «группа = версия Android»: switch.timeout действует на обоих
     путях (с разным смыслом), поэтому группа «Задержки переключения» названа
     нейтрально, а не «(Android 6-9)». -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  android:title="@string/prefs_title">

    <PreferenceScreen android:fragment="ru.cobra.zap.afrd.gui.SettingsFragment"
                      android:key="main" android:title="@string/prefs_group_main">
        <SwitchPreference android:defaultValue="1" android:key="enable" android:summary="@string/prefsum_enable"
                          android:title="@string/prefs_enable"/>
        <SwitchPreference android:defaultValue="1" android:key="pause_keep"
                          android:summary="@string/prefsum_pause_keep"
                          android:title="@string/prefs_pause_keep"/>
        <!-- switch.delay.off — ключ обоих путей: на Android 12-14 это предел
             удержания режима на паузе, на старом пути — задержка возврата после
             остановки видео. Стоит рядом с паузой, потому что на новом пути его
             смысл читается только здесь (журнал §33.1). -->
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="10000" android:key="switch_delay_off"
                            android:maxLength="5" android:numeric="integer" android:selectAllOnFocus="true"
                            android:singleLine="true" android:summary="@string/prefsum_switch_delay_off"
                            android:title="@string/prefs_switch_delay_off"/>
        <SwitchPreference android:defaultValue="1" android:key="switch_restore_on_stop"
                          android:summary="@string/prefsum_switch_restore_on_stop"
                          android:title="@string/prefs_switch_restore_on_stop"/>
    </PreferenceScreen>

    <PreferenceScreen android:fragment="ru.cobra.zap.afrd.gui.SettingsFragment"
                      android:key="players" android:title="@string/prefs_group_players">
        <!-- switch.skip.pkg — ключ обоих путей (CFGKEY_BOTH), поэтому он здесь,
             вместе с остальными настройками про плееры, а не в группе нового
             пути. -->
        <ru.cobra.zap.xprefs.XAppsPreference android:key="switch_skip_pkg"
                          android:summary="@string/prefsum_switch_skip_pkg"
                          android:title="@string/prefs_switch_skip_pkg"/>
        <ru.cobra.zap.xprefs.XAppsPreference android:key="mode_min_hz_list"
                          android:summary="@string/prefsum_mode_min_hz_list"
                          android:title="@string/prefs_mode_min_hz_list"/>
        <SwitchPreference android:defaultValue="1" android:key="fps_correct_enable"
                          android:summary="@string/prefsum_fps_correct_enable"
                          android:title="@string/prefs_fps_correct_enable"/>
        <ru.cobra.zap.xprefs.XAppsPreference android:key="fps_correct_list"
                          android:summary="@string/prefsum_fps_correct_list"
                          android:title="@string/prefs_fps_correct_list"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="0.1" android:key="fps_correct_av1_offset"
                          android:selectAllOnFocus="false" android:singleLine="true"
                          android:summary="@string/prefsum_fps_correct_av1_offset"
                          android:title="@string/prefs_fps_correct_av1_offset"/>
        <ru.cobra.zap.xprefs.XAppsPreference android:key="fps_correct_av1_pkg"
                          android:summary="@string/prefsum_fps_correct_av1_pkg"
                          android:title="@string/prefs_fps_correct_av1_pkg"/>
    </PreferenceScreen>

    <PreferenceScreen android:fragment="ru.cobra.zap.afrd.gui.SettingsFragment"
                      android:key="mode" android:title="@string/prefs_group_mode">
        <SwitchPreference android:defaultValue="0" android:key="mode_prefer_exact"
                          android:summary="@string/prefsum_mode_prefer_exact"
                          android:title="@string/prefs_mode_prefer_exact"/>
        <ru.cobra.zap.xprefs.XListPreference android:defaultValue="0" android:entries="@array/mode_use_fract"
                        android:entryValues="@array/mode_use_fract_value" android:key="mode_use_fract"
                        android:summary="@string/prefsum_mode_use_fract"
                        android:title="@string/prefs_mode_use_fract"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:key="mode_blacklist_rates" android:selectAllOnFocus="false"
                            android:singleLine="true"
                            android:summary="@string/prefsum_mode_blacklist_rates"
                            android:title="@string/prefs_mode_blacklist_rates"/>
    </PreferenceScreen>

    <PreferenceScreen android:fragment="ru.cobra.zap.afrd.gui.SettingsFragment"
                      android:key="misc" android:title="@string/settings_misc">
        <SwitchPreference android:defaultValue="0" android:key="log_enable"
                          android:summary="@string/prefsum_log_enable"
                          android:title="@string/prefs_log_enable"/>
        <SwitchPreference android:layout_width="wrap_content" android:layout_height="wrap_content"
                          android:defaultValue="1" android:key="toast_hz"
                          android:summary="@string/prefsum_toast" android:title="@string/prefs_toast"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:key="mode_extra" android:selectAllOnFocus="false"
                            android:singleLine="true" android:summary="@string/prefsum_mode_extra"
                            android:title="@string/prefs_mode_extra"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="2160p[4-9].*=420 .*=444" android:key="cs_select"
                            android:selectAllOnFocus="false" android:singleLine="true"
                            android:summary="@string/prefsum_cs_select"
                            android:title="@string/prefs_cs_select"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="/data/local/afrd.log" android:key="log_file"
                            android:selectAllOnFocus="false" android:singleLine="true"
                            android:summary="@string/prefsum_log_file"
                            android:title="@string/prefs_log_file"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:key="vdec_blacklist"
                            android:selectAllOnFocus="false" android:singleLine="true"
                            android:summary="@string/prefsum_vdec_blacklist"
                            android:title="@string/prefs_vdec_blacklist"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:key="frhint_vdec_blacklist"
                            android:selectAllOnFocus="false" android:singleLine="true"
                            android:summary="@string/prefsum_frhint_vdec_blacklist"
                            android:title="@string/prefs_frhint_vdec_blacklist"/>
    </PreferenceScreen>

    <PreferenceScreen android:fragment="ru.cobra.zap.afrd.gui.SettingsFragment"
                      android:key="timings" android:title="@string/prefs_group_timings">
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="300" android:key="switch_delay_on"
                            android:maxLength="5" android:numeric="integer" android:selectAllOnFocus="true"
                            android:singleLine="true" android:summary="@string/prefsum_switch_delay_on"
                            android:title="@string/prefs_switch_delay_on"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="100" android:key="switch_delay_retry"
                            android:maxLength="5" android:numeric="integer" android:selectAllOnFocus="true"
                            android:singleLine="true" android:summary="@string/prefsum_switch_delay_retry"
                            android:title="@string/prefs_switch_delay_retry"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="3000" android:key="switch_timeout"
                            android:maxLength="5" android:numeric="integer" android:selectAllOnFocus="true"
                            android:singleLine="true" android:summary="@string/prefsum_switch_timeout"
                            android:title="@string/prefs_switch_timeout"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="150" android:key="switch_blackout"
                            android:maxLength="5" android:numeric="integer" android:selectAllOnFocus="true"
                            android:singleLine="true" android:summary="@string/prefsum_switch_blackout"
                            android:title="@string/prefs_switch_blackout"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="200" android:key="switch_ignore"
                            android:maxLength="5" android:numeric="integer" android:selectAllOnFocus="true"
                            android:singleLine="true" android:summary="@string/prefsum_switch_ignore"
                            android:title="@string/prefs_switch_ignore"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="2000" android:key="switch_hdmi"
                            android:maxLength="5" android:numeric="integer" android:selectAllOnFocus="true"
                            android:singleLine="true" android:summary="@string/prefsum_switch_hdmi"
                            android:title="@string/prefs_switch_hdmi"/>
    </PreferenceScreen>

    <PreferenceScreen android:fragment="ru.cobra.zap.afrd.gui.SettingsFragment"
                      android:key="atv14" android:title="@string/prefs_group_atv14">
        <SwitchPreference android:defaultValue="1" android:key="fps_prefer_api"
                          android:summary="@string/prefsum_fps_prefer_api"
                          android:title="@string/prefs_fps_prefer_api"/>
        <!-- Быстрое решение по заявленной частоте: умолчание зависит от версии
             Android (10/11 — включено, как у штатного системного AFR; 12-14 —
             выключено). Проставить его правильно может только приложение
             (знает версию), поэтому здесь безопасное значение 0, а на 10/11
             приложение записывает 1 в ini и в свои настройки при первом запуске
             (MainActivity.prepareConfig). Иначе XML-умолчание перебило бы
             умолчание пути и включило быстрый путь на 12-14. -->
        <SwitchPreference android:defaultValue="0" android:key="fps_declare_fast"
                          android:summary="@string/prefsum_fps_declare_fast"
                          android:title="@string/prefs_fps_declare_fast"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="20000" android:key="fps_measure_envelope_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_measure_envelope"
                          android:title="@string/prefs_fps_measure_envelope"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="30000" android:key="fps_measure_envelope_max_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_measure_envelope_max"
                          android:title="@string/prefs_fps_measure_envelope_max"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="14000" android:key="fps_measure_envelope_early_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_measure_envelope_early"
                          android:title="@string/prefs_fps_measure_envelope_early"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="5000" android:key="fps_measure_envelope_sub_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_measure_envelope_sub"
                          android:title="@string/prefs_fps_measure_envelope_sub"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="2000" android:key="fps_measure_envelope_skip_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_measure_envelope_skip"
                          android:title="@string/prefs_fps_measure_envelope_skip"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="3" android:key="fps_measure_retries"
                          android:maxLength="3" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_measure_retries"
                          android:title="@string/prefs_fps_measure_retries"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="5" android:key="fps_declared_crosscheck_pct"
                          android:maxLength="3" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_declared_crosscheck"
                          android:title="@string/prefs_fps_declared_crosscheck"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="4000" android:key="fps_recheck_delay_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_recheck_delay"
                          android:title="@string/prefs_fps_recheck_delay"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="2500" android:key="fps_cadence_fix_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_fps_cadence_fix"
                          android:title="@string/prefs_fps_cadence_fix"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="300" android:key="trigger_poll_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_trigger_poll"
                          android:title="@string/prefs_trigger_poll"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="500" android:key="trigger_start_debounce_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_trigger_start_debounce"
                          android:title="@string/prefs_trigger_start_debounce"/>
        <ru.cobra.zap.xprefs.XEditTextPreference android:defaultValue="1500" android:key="trigger_stop_debounce_ms"
                          android:maxLength="6" android:numeric="integer" android:selectAllOnFocus="true"
                          android:singleLine="true" android:summary="@string/prefsum_trigger_stop_debounce"
                          android:title="@string/prefs_trigger_stop_debounce"/>
    </PreferenceScreen>
</PreferenceScreen>
