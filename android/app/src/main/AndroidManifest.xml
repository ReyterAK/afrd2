<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Сеанс «AFR по требованию»: команда уходит демону по UDP на loopback
         (127.0.0.1:50505). Без INTERNET сокет не создаётся вовсе — проверено
         живьём: команда молча не доходила, а приложение показывало «демон не
         запущен». -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14: тип службы specialUse требует своего разрешения. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Android 13: без него уведомление службы не видно (сама служба работает). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android 11+: список «Все приложения» и определение плееров по пакетам
         требуют видимости пакетов. Приложение ставится сайдлоадом, для Play
         это разрешение не годится (tools:ignore — на lint). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
                     tools:ignore="QueryAllPackagesPermission"/>

    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application android:icon="@mipmap/ic_launcher" android:label="@string/app_name"
                 android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true"
                 tools:ignore="GoogleAppIndexingWarning" android:theme="@style/AppTheme"
                 android:banner="@drawable/ic_afrd_tv"
                 android:allowBackup="true" android:fullBackupContent="@xml/backup_files">

        <activity android:name="ru.cobra.zap.afrd.gui.MainActivity" android:label="@string/app_name"
                  android:exported="true"
                  android:screenOrientation="landscape"
                  android:configChanges="orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                       android:resource="@xml/shortcuts"/>
        </activity>

        <activity android:name="ru.cobra.zap.afrd.gui.ActionActivity" android:exported="true">
            <intent-filter>
                <action android:name="ru.cobra.afrd.START"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="ru.cobra.afrd.STOP"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- Сеанс «AFR по требованию» (журнал §84): вызывается маппером кнопок.
             Своего окна не показывает, только тост. -->
        <activity android:name="ru.cobra.zap.afrd.gui.BurstActivity"
                  android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="ru.cobra.afrd.BURST"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- Пункт в списке приложений для мапперов кнопок: tvQuickActions и
             подобные умеют запускать приложение, но не всегда — activity с
             action/extras. Алиас даёт «AFR burst» как обычное приложение. -->
        <activity-alias android:name="ru.cobra.zap.afrd.gui.BurstAlias"
                        android:targetActivity="ru.cobra.zap.afrd.gui.BurstActivity"
                        android:exported="true"
                        android:label="@string/burst_alias_label"
                        android:icon="@mipmap/ic_launcher"
                        android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Команда сеанса broadcast-ом: для Button Mapper и shell. -->
        <receiver android:name="ru.cobra.zap.afrd.gui.BurstReceiver"
                  android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="ru.reyter.afrd2.action.BURST"/>
            </intent-filter>
        </receiver>

        <activity android:name="ru.cobra.zap.afrd.gui.AppsPickerActivity"
                  android:configChanges="orientation" android:exported="false"
                  android:screenOrientation="landscape"/>

        <receiver android:name="ru.cobra.zap.afrd.gui.BootCompleteReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <category android:name="android.intent.category.HOME"/>
            </intent-filter>
        </receiver>

        <service android:name="ru.cobra.zap.afrd.gui.AFRService" android:enabled="true"
                 android:exported="false"
                 android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="display mode and frame rate control via root daemon"/>
        </service>
    </application>

</manifest>