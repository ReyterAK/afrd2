<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.reyter.afrd2.burst"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!--
     Отдельный пакет: tvQuickActions показывает одну запись на пакет,
         поэтому activity-alias внутри AFRd2 в его списке приложений не виден.
    -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_afrd_tv"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoDisplay" >
        <activity
            android:name="ru.reyter.afrd2.burst.BurstLaunchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>